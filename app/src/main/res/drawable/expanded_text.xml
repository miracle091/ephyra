<?xml version="1.0" encoding="utf-8"?>
<!-- Velella: a focused overview gets the list items' surface-3 fill (progressBackground in every Velella theme) with radius-md,
     instead of a black shade that disappears on the dark background -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="?attr/progressBackground" />
        </shape>
    </item>
</selector>
