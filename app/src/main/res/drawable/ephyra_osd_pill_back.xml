<?xml version="1.0" encoding="utf-8"?>
<!-- Ephyra: the player's text buttons (Guide, Record, Channels) after the design system's Button: surface-2, a full pill, the solid
     ink fill when focused like the round icon buttons -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="@integer/button_fade_duration"
    android:exitFadeDuration="@integer/button_fade_duration">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/headerTextColor" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/popupMenuBackground" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
