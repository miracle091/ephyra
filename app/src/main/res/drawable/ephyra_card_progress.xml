<?xml version="1.0" encoding="utf-8"?>
<!-- Ephyra: the progress bar of cards and guide cells, the View twin of CardProgressBar: a black 38% track with square ends and a fill
     in the theme's accent (colorAccent). The card clips it to its rounded corners -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/ephyra_card_progress_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="?android:attr/colorAccent" />
            </shape>
        </clip>
    </item>
</layer-list>
