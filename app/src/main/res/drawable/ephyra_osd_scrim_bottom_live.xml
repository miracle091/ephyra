<?xml version="1.0" encoding="utf-8"?>
<!-- Ephyra: the live player's bottom shade. The title block sits high in the controls, so the shade stays dense up to the top
     fifth before it fades, to keep the title legible over bright video -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#CC050814"
        android:centerY="0.8"
        android:endColor="#00050814"
        android:startColor="#E6050814" />
</shape>
