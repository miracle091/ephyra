<?xml version="1.0" encoding="utf-8"?>
<!-- Ephyra: a cell of the Live TV guide (programme, channel, paging button): surface-2 with radius-md, surface-3 when focused, a 2dp
     gap around it so neighbours read as separate cells -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="@integer/button_fade_duration"
    android:exitFadeDuration="@integer/button_fade_duration">
    <item android:state_focused="true">
        <inset
            android:insetBottom="2dp"
            android:insetLeft="2dp"
            android:insetRight="2dp"
            android:insetTop="2dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/progressBackground" />
                <stroke
                    android:width="3dp"
                    android:color="?attr/headerTextColor" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset
            android:insetBottom="2dp"
            android:insetLeft="2dp"
            android:insetRight="2dp"
            android:insetTop="2dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/popupMenuBackground" />
                <corners android:radius="12dp" />
            </shape>
        </inset>
    </item>
</selector>
