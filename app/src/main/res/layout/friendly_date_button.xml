<?xml version="1.0" encoding="utf-8"?>
<!-- Ephyra: a day of the guide's date picker, a guide cell: its focus state follows the FriendlyDateButton that holds it -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:background="@drawable/ephyra_guide_cell"
    android:duplicateParentState="true"
    android:gravity="center"
    android:padding="12dp">

    <TextView
        android:id="@+id/friendlyName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:textColor="?attr/headerTextColor"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Today" />

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/friendlyName"
        android:layout_alignParentStart="true"
        android:textColor="?attr/controlIconForegroundInactive"
        android:textSize="14sp"
        tools:text="11/08/2026" />
</RelativeLayout>
