<?xml version="1.0" encoding="utf-8"?>
<!-- Velella: a channel of the Live TV guide, the number in mono over the name, the logo top right (up to 72dp wide, so wide logos
     stay legible, and 24dp tall, so it stays above the name: the header has 43dp inside); the name takes the whole width and scrolls while the header has focus. The cell background and its
     focus state come from GuideChannelHeader -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/channelNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:fontFamily="@font/atkinson_hyperlegible_mono"
        android:maxLines="1"
        android:textColor="?attr/controlIconForegroundInactive"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="102" />

    <TextView
        android:id="@+id/channelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@+id/favImage"
        android:ellipsize="marquee"
        android:includeFontPadding="false"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:textColor="?attr/headerTextColor"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Sport Uno" />

    <org.jellyfin.androidtv.ui.AsyncImageView
        android:id="@+id/channelImage"
        android:layout_width="72dp"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:scaleType="fitEnd" />

    <ImageView
        android:id="@+id/favImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:contentDescription="@null"
        android:scaleType="center"
        android:src="@drawable/ic_heart_accent"
        android:visibility="gone" />
</RelativeLayout>
