<?xml version="1.0" encoding="utf-8"?>
<!-- Ephyra: the details of a film, series, episode or person after the design system's detail hero, without the backdrop: the
     poster on the left with radius-md, the genres as an accent overline, a bold title, the info row, the overview, the director,
     runtime and end time as small label/value pairs and the icon buttons on the right -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ephyra_side_margin"
        android:paddingTop="95dp"
        android:paddingEnd="@dimen/ephyra_side_margin"
        android:paddingBottom="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/cardImageBackground"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <org.jellyfin.androidtv.ui.AsyncImageView
                android:id="@+id/mainImage"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:maxHeight="300dp"
                android:scaleType="fitCenter"
                tools:srcCompat="@drawable/app_banner" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:clipChildren="false"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fdGenreRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="?android:attr/colorAccent"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Animation / Comedy" />

            <TextView
                android:id="@+id/fdTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/headerTextColor"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="Title" />

            <LinearLayout
                android:id="@+id/fdMainInfoRow"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="4dp"
                android:dividerPadding="4sp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <org.jellyfin.androidtv.ui.ExpandableTextView
                android:id="@+id/fdSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="-12dp"
                android:layout_marginBottom="-8dp"
                android:ellipsize="end"
                android:lineSpacingExtra="3sp"
                android:maxLines="3"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textColor="?attr/controlIconForegroundInactive"
                android:textSize="14sp"
                tools:text="Overview" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="32dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/infoTitle1"
                        style="@style/TextAppearance.Ephyra.InfoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Directed by" />

                    <TextView
                        android:id="@+id/infoValue1"
                        style="@style/TextAppearance.Ephyra.InfoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Name" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="32dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/infoTitle2"
                        style="@style/TextAppearance.Ephyra.InfoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Runs" />

                    <TextView
                        android:id="@+id/infoValue2"
                        style="@style/TextAppearance.Ephyra.InfoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="3m" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/infoTitle3"
                        style="@style/TextAppearance.Ephyra.InfoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Ends" />

                    <TextView
                        android:id="@+id/infoValue3"
                        style="@style/TextAppearance.Ephyra.InfoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="9:18 PM" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fdButtonRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
