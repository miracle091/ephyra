<?xml version="1.0" encoding="utf-8"?>
<!-- Ephyra: the design system's music player: a 300dp cover on the left, "Now playing · Album", the title, "Artist · Year",
     the seekbar and the controls on the right, filling the screen; the queue row sits below and scrolls in on focus -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/detailArea"
                android:layout_width="match_parent"
                android:layout_height="540dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ephyra_side_margin"
                android:paddingTop="48dp"
                android:paddingEnd="@dimen/ephyra_side_margin"
                android:paddingBottom="27dp">

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/preview"
                    android:layout_width="300dp"
                    android:layout_height="300dp" />

                <LinearLayout
                    android:id="@+id/information"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/album"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:textAllCaps="true"
                        android:textColor="?android:attr/colorAccent"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Now playing · Album" />

                    <TextView
                        android:id="@+id/song"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:letterSpacing="-0.02"
                        android:maxLines="2"
                        android:textColor="?attr/headerTextColor"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        tools:text="@string/lbl_song_title" />

                    <TextView
                        android:id="@+id/artistTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/controlIconForegroundInactive"
                        android:textSize="16sp"
                        tools:text="Artist · 2019" />

                    <LinearLayout
                        android:id="@id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/currentPos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/controlIconForegroundInactive"
                            android:textSize="14sp"
                            tools:text="0:00" />

                        <androidx.compose.ui.platform.ComposeView
                            android:id="@+id/playerProgress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/remainingTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/controlIconForegroundInactive"
                            android:textSize="14sp"
                            tools:text="-5:00" />
                    </LinearLayout>

                    <!-- Shuffle and repeat stay at the ends of the playback controls, as in the design; album and artist follow; the row spans the seekbar -->
                    <LinearLayout
                        android:id="@+id/buttonRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-12dp"
                        android:layout_marginEnd="-12dp"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/shuffleBtn"
                            style="@style/Button.Ephyra.PlayerIcon"
                            android:src="@drawable/ic_shuffle" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/prevBtn"
                            style="@style/Button.Ephyra.PlayerIcon"
                            android:src="@drawable/ic_previous" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/rewindBtn"
                            style="@style/Button.Ephyra.PlayerIcon"
                            android:src="@drawable/ic_rewind" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/playPauseBtn"
                            style="@style/Button.Ephyra.PlayerIcon.Large"
                            android:src="@drawable/ic_pause" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/fastForwardBtn"
                            style="@style/Button.Ephyra.PlayerIcon"
                            android:src="@drawable/ic_fast_forward" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/nextBtn"
                            style="@style/Button.Ephyra.PlayerIcon"
                            android:src="@drawable/ic_next" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/repeatBtn"
                            style="@style/Button.Ephyra.PlayerIcon"
                            android:src="@drawable/ic_loop" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/albumBtn"
                            style="@style/Button.Ephyra.PlayerIcon"
                            android:src="@drawable/ic_album" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/artistBtn"
                            style="@style/Button.Ephyra.PlayerIcon"
                            android:src="@drawable/ic_user" />
                    </LinearLayout>

                    <!-- Kept for the fragment, not shown in the design -->
                    <TextView
                        android:id="@+id/genreRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/track"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/rowsFragment"
                android:layout_width="match_parent"
                android:layout_height="300dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <org.jellyfin.androidtv.ui.ClockUserView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/ephyra_clock_top"
        android:layout_marginEnd="@dimen/ephyra_side_margin" />
</RelativeLayout>
