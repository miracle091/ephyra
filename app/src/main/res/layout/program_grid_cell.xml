<?xml version="1.0" encoding="utf-8"?>
<!-- Velella: a programme of the Live TV guide, name over the tags; the programme on air gets a red dot before its name and an accent bar on the bottom edge. The cell
     background and its focus state come from ProgramGridCell -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="55dp"
    tools:layout_width="210dp">

    <TextView
        android:id="@+id/programName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:maxLines="1"
        android:drawablePadding="8dp"
        android:text="@string/no_program_data"
        android:textColor="?attr/headerTextColor"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/infoRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/programName"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:divider="@drawable/blank10x10"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:showDividers="middle" />

    <ImageView
        android:id="@+id/recIndicator"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_alignTop="@+id/infoRow"
        android:layout_alignBottom="@+id/infoRow"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/infoRow"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_record_series_red" />

    <ProgressBar
        android:id="@+id/nowBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/velella_card_progress_height"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="2dp"
        android:layout_marginBottom="2dp"
        android:max="1000"
        android:progressDrawable="@drawable/velella_card_progress"
        android:visibility="gone" />
</RelativeLayout>
