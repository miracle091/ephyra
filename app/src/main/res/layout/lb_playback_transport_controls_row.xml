<?xml version="1.0" encoding="utf-8"?>
<!-- Ephyra: replaces Leanback's layout of the same name with the design system's "Player" board: the seek bar first, the
     times under it, then one row of buttons, the primary group on the left and the secondary group on the right, over a
     bottom shade. It keeps every id Leanback's PlaybackTransportRowPresenter looks up. PlaybackTransportRowView moves the
     focus up and down between its children in order and left and right inside the focused child, so the two groups share
     one row to be reachable from each other -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ephyra_osd_scrim_bottom"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingTop="96dp"
    android:paddingBottom="@dimen/ephyra_osd_padding_bottom">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/controls_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ephyra_side_margin"
            android:paddingEnd="@dimen/ephyra_side_margin">

            <ImageView
                android:id="@+id/image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart" />

            <FrameLayout
                android:id="@+id/description_dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <androidx.leanback.widget.ThumbsBar
            android:id="@+id/thumbs_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:visibility="invisible" />
    </FrameLayout>

    <androidx.leanback.widget.PlaybackTransportRowView
        android:id="@+id/transport_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/ephyra_side_margin"
        android:paddingEnd="@dimen/ephyra_side_margin">

        <androidx.leanback.widget.SeekBar
            android:id="@+id/playback_progress"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:focusable="true" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr">

            <TextView
                android:id="@+id/current_time"
                style="@style/TextAppearance.Ephyra.OsdTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                tools:text="24:20" />

            <TextView
                android:id="@+id/separate_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- CustomPlaybackTransportControlGlue puts the end time here -->
            <FrameLayout
                android:id="@+id/ephyra_ends_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="24dp"
                android:layout_toStartOf="@id/total_time" />

            <TextView
                android:id="@+id/total_time"
                style="@style/TextAppearance.Ephyra.OsdTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                tools:text="45:00" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/controls_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/secondary_controls_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.leanback.widget.PlaybackTransportRowView>
</LinearLayout>
