<?xml version="1.0" encoding="utf-8"?>
<!-- Velella: replaces Leanback's layout of the same name with the design system's "Player" board: the seek bar first, the
     times under it, then one row of buttons, the primary group on the left and the secondary group on the right, over a
     bottom shade. It keeps every id Leanback's PlaybackTransportRowPresenter looks up. PlaybackTransportRowView moves the
     focus up and down between its children in order and left and right inside the focused child, so the two groups share
     one row to be reachable from each other -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/velella_osd_scrim_bottom"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingTop="96dp"
    android:paddingBottom="@dimen/velella_osd_padding_bottom">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/controls_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="@dimen/velella_side_margin"
            android:paddingEnd="@dimen/velella_side_margin">

            <ImageView
                android:id="@+id/image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart" />

            <FrameLayout
                android:id="@+id/description_dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <androidx.leanback.widget.ThumbsBar
            android:id="@+id/thumbs_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- Velella: the live player's title block after the design system's "Live TV" board: the programme's details and name above
         the seek bar (OsdHeader.bindProgramme), gone for everything else -->
    <LinearLayout
        android:id="@+id/velella_live_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/velella_side_margin"
        android:paddingEnd="@dimen/velella_side_margin"
        android:visibility="gone">

        <TextView
            android:id="@+id/velella_live_overline"
            style="@style/TextAppearance.Velella.OsdOverline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Calcio · 12ª giornata" />

        <TextView
            android:id="@+id/velella_live_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/headerTextColor"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Lazio – Torino" />
    </LinearLayout>

    <androidx.leanback.widget.PlaybackTransportRowView
        android:id="@+id/transport_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/velella_side_margin"
        android:paddingEnd="@dimen/velella_side_margin">

        <androidx.leanback.widget.SeekBar
            android:id="@+id/playback_progress"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:focusable="true" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr">

            <TextView
                android:id="@+id/current_time"
                style="@style/TextAppearance.Velella.OsdTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                tools:text="24:20" />

            <TextView
                android:id="@+id/separate_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- CustomPlaybackTransportControlGlue puts the end time here -->
            <FrameLayout
                android:id="@+id/velella_ends_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="24dp"
                android:layout_toStartOf="@id/total_time" />

            <TextView
                android:id="@+id/total_time"
                style="@style/TextAppearance.Velella.OsdTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                tools:text="45:00" />
        </RelativeLayout>

        <!-- Velella: the live player's "Next:" line and play method under the times, as in the board (NextProgram.kt, PlayInfo.kt) -->
        <TextView
            android:id="@+id/velella_live_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/controlIconForegroundInactive"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Next: Notiziario sportivo · 22:45" />

        <TextView
            android:id="@+id/velella_live_play_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/controlIconForegroundInactive"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Transcoding: video codec not supported" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/controls_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Velella: the live player's text buttons, filled by CustomPlaybackTransportControlGlue.updatePills -->
            <LinearLayout
                android:id="@+id/velella_pills_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/secondary_controls_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.leanback.widget.PlaybackTransportRowView>
</LinearLayout>
