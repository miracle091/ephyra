<?xml version="1.0" encoding="utf-8"?>
<!-- Ephyra: the Coral theme, warm dark red with a coral accent (same colours as design/.../EphyraColorTokens.kt) -->
<resources>

    <color name="ephyra_coral_bg">#1A0E10</color>
    <color name="ephyra_coral_surface_1">#261518</color>
    <color name="ephyra_coral_surface_2">#341E22</color>
    <color name="ephyra_coral_surface_3">#45292E</color>
    <color name="ephyra_coral_line_strong">#A07873</color>
    <color name="ephyra_coral_ink_muted">#D6BCBA</color>
    <color name="ephyra_coral_ink_faint">#B0928F</color>
    <color name="ephyra_coral_accent">#FF8A65</color>

    <style name="Theme.Jellyfin.Ephyra.Coral" parent="Theme.Jellyfin.Ephyra">
        <item name="android:colorPrimary">@color/ephyra_coral_bg</item>
        <item name="android:colorPrimaryDark">@color/ephyra_coral_bg</item>
        <item name="android:colorAccent">@color/ephyra_coral_accent</item>
        <item name="defaultBackground">@color/ephyra_coral_bg</item>
        <item name="cardImageBackground">@color/ephyra_coral_surface_1</item>
        <item name="defaultSearchColor">@color/ephyra_coral_accent</item>
        <item name="android:colorButtonNormal">@color/ephyra_coral_surface_2</item>
        <item name="buttonDefaultNormalBackground">@color/ephyra_coral_surface_2</item>
        <item name="inputDefaultStrokeColor">@color/ephyra_coral_line_strong</item>
        <item name="popupMenuBackground">@color/ephyra_coral_surface_2</item>
        <item name="progressBackground">@color/ephyra_coral_surface_3</item>
        <item name="progressPrimary">@color/ephyra_coral_accent</item>
        <item name="progressSecondary">@color/ephyra_coral_ink_faint</item>
        <item name="controlIconBackground">@color/ephyra_coral_surface_2</item>
        <item name="controlIconForegroundActive">@color/ephyra_coral_accent</item>
        <item name="controlIconForegroundInactive">@color/ephyra_coral_ink_muted</item>
    </style>
</resources>
