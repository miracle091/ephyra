<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ephyra: the live player's channel line next to the LIVE badge, 16sp bold ink -->
    <style name="TextAppearance.Ephyra.OsdChannel" parent="">
        <item name="android:textColor">?attr/headerTextColor</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Ephyra: the design system's danger badge, 20dp high, 4dp radius, bold 11sp caps -->
    <style name="TextAppearance.Ephyra.OsdBadge" parent="">
        <item name="android:textColor">@color/ephyra_osd_on_danger</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
