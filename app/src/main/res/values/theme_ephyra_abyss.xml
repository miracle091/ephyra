<?xml version="1.0" encoding="utf-8"?>
<!-- Ephyra: the Abyss theme, deep teal with a mint accent (same colours as design/.../EphyraColorTokens.kt) -->
<resources>

    <color name="ephyra_abyss_bg">#06171A</color>
    <color name="ephyra_abyss_surface_1">#0D2428</color>
    <color name="ephyra_abyss_surface_2">#15333A</color>
    <color name="ephyra_abyss_surface_3">#1F444C</color>
    <color name="ephyra_abyss_line_strong">#5E8A8E</color>
    <color name="ephyra_abyss_ink_muted">#B0CCCC</color>
    <color name="ephyra_abyss_ink_faint">#86A6A8</color>
    <color name="ephyra_abyss_accent">#3DDCB4</color>

    <style name="Theme.Jellyfin.Ephyra.Abyss" parent="Theme.Jellyfin.Ephyra">
        <item name="android:colorPrimary">@color/ephyra_abyss_bg</item>
        <item name="android:colorPrimaryDark">@color/ephyra_abyss_bg</item>
        <item name="android:colorAccent">@color/ephyra_abyss_accent</item>
        <item name="defaultBackground">@color/ephyra_abyss_bg</item>
        <item name="cardImageBackground">@color/ephyra_abyss_surface_1</item>
        <item name="defaultSearchColor">@color/ephyra_abyss_accent</item>
        <item name="android:colorButtonNormal">@color/ephyra_abyss_surface_2</item>
        <item name="buttonDefaultNormalBackground">@color/ephyra_abyss_surface_2</item>
        <item name="inputDefaultStrokeColor">@color/ephyra_abyss_line_strong</item>
        <item name="popupMenuBackground">@color/ephyra_abyss_surface_2</item>
        <item name="progressBackground">@color/ephyra_abyss_surface_3</item>
        <item name="progressPrimary">@color/ephyra_abyss_accent</item>
        <item name="progressSecondary">@color/ephyra_abyss_ink_faint</item>
        <item name="controlIconBackground">@color/ephyra_abyss_surface_2</item>
        <item name="controlIconForegroundActive">@color/ephyra_abyss_accent</item>
        <item name="controlIconForegroundInactive">@color/ephyra_abyss_ink_muted</item>
    </style>
</resources>
