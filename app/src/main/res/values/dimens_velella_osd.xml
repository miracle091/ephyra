<?xml version="1.0" encoding="utf-8"?>
<!-- Velella: the video player's controls after the design system's "Player" board. Leanback spaces its control buttons by the
     distance between their centres, child_margin_default + control_icon_width: 32 + 24 = a 48dp button and an 8dp gap -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <dimen name="lb_playback_controls_child_margin_default" tools:override="true">32dp</dimen>
    <dimen name="lb_control_icon_width" tools:override="true">24dp</dimen>
    <!-- The controls row reaches the screen's bottom edge, so its shade does too; the row keeps the safe area as padding.
         Leanback (PlaybackSupportFragment) aligns the row's bottom this far above the screen's edge and hides the row with 0, so
         1dp is the smallest that works; LeanbackOverlayFragment.onStart moves the alignment line to the bottom edge -->
    <dimen name="lb_playback_controls_padding_bottom" tools:override="true">1dp</dimen>
    <dimen name="velella_osd_button">48dp</dimen>
    <dimen name="velella_osd_icon">24dp</dimen>
    <dimen name="velella_osd_pill_gap">8dp</dimen>
    <dimen name="velella_osd_badge_height">20dp</dimen>
    <dimen name="velella_safe_y">27dp</dimen>
    <!-- Close to the bottom edge, as the user asked: the icons sit 16dp from it, the focus circle 5dp
         (the row now ends 1dp lower, at the edge, so the padding is 5dp to keep that) -->
    <dimen name="velella_osd_padding_bottom">5dp</dimen>
</resources>
